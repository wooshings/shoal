	c.value |= i32(data[off^+0]) << 0
	c.value |= i32(data[off^+1]) << 8
	c.value |= i32(data[off^+2]) << 16
	c.value |= i32(data[off^+3]) << 24
	off^ += 4
}

register_replicated_components :: proc() {
