	append(buf, u8(v >> 8))
	append(buf, u8(v >> 16))
	append(buf, u8(v >> 24))
	return len(buf^) - start
}

deserialize_health :: proc(world: ^ecs.World, entity: ecs.Entity, data: []u8, off: ^int) {
	c, ok := ecs.try_get_component(world, entity, Health)
